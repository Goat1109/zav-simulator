      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Distance: 15.29836368560791
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: -0.3284287452697754
        Y: 0.08110880851745605
        Z: -1.835918664932251
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.5697972774505615
      Target Frame: zav_body
      Value: XYOrbit (rviz_default_plugins)
      Yaw: 6.1903886795043945
    Saved: ~
