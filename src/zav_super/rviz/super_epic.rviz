Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Sensing1
        - /EPIC exploration1
      Splitter Ratio: 0.5
    Tree Height: 1147
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5613383054733276
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 4.014019966125488
            Min Value: 0
            Value: false
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 245; 121; 0
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 0
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: LocalCloud
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.009999999776482582
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /zav/super/cloud_world
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 4.014019966125488
            Min Value: -6
            Value: false
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 136; 138; 133
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 0
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: GlobalCloud
          Position Transformer: XYZ
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.10000000149011612
          Style: Points
          Topic:
            Depth: 3
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /rog_map/occ
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: Sensing
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Robot
      Namespaces:
        mesh: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robot
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: ExpTraj
      Namespaces:
        exp_traj: true
        exp_traj_waypoints: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visualization/exp_traj
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: BackupTraj
      Namespaces:
        backup_traj: true
        backup_traj_waypoints: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visualization/backup_traj
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 245; 121; 0
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Billboards
      Line Width: 0.30000001192092896
      Name: Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fsm/path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MarkerArray
      Namespaces:
        goal: true
        goal_line: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visualization/goal
      Value: true
    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.10000000149011612
      Class: rviz_default_plugins/Pose
      Color: 255; 25; 0
      Enabled: true
      Head Length: 0.30000001192092896
      Head Radius: 0.10000000149011612
      Name: Pose
      Shaft Length: 1
      Shaft Radius: 0.05000000074505806
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MarkerArray
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /mission/mkr
      Value: true
    - Class: rviz_common/Group
      Name: EPIC exploration
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Path
          Name: Global guide and viewpoint yaw
          Enabled: true
          Value: true
          Topic:
            Value: /mission/exploration_path
            Depth: 1
            Durability Policy: Transient Local
            Reliability Policy: Reliable
            History Policy: Keep Last
          Color: 214; 126; 242
          Alpha: 0.85
          Line Style: Billboards
          Line Width: 0.026
          Buffer Length: 1
          Pose Style: Arrows
          Pose Color: 214; 126; 242
          Shaft Length: 0.22
          Shaft Diameter: 0.025
          Head Length: 0.10
          Head Diameter: 0.065
        - Class: rviz_default_plugins/MarkerArray
          Name: Viewpoint visit order
          Enabled: true
          Value: true
          Topic:
            Value: /global_tour
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
          Namespaces:
            global_path: false
            global_path_order: true
        - Class: rviz_default_plugins/MarkerArray
          Name: Frontier viewpoints
          Enabled: true
          Value: true
          Topic:
            Value: /sf_cluster_marker
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
          Namespaces:
            best_viewpoint: true
            aabb: false
            viewpoint_number: false
            vp_frt_connecter: false
        - Class: rviz_default_plugins/Marker
          Name: Exploration state
          Enabled: true
          Value: true
          Topic:
            Value: /epic/state
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/PointCloud2
          Name: Frontier cells
          Enabled: false
          Value: false
          Topic:
            Value: /frt
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 1
          Position Transformer: XYZ
          Color Transformer: FlatColor
          Color: 230; 75; 145
          Alpha: 0.6
          Style: Points
          Size (Pixels): 3
          Decay Time: 0
  Enabled: true
  Global Options:
    Background Color: 52; 58; 67
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/SetGoal
