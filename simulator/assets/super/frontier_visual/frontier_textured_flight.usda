    def Xform "CollisionSurface" (
        prepend references = @frontier_collision.usdc@</CollisionSurface>
    )
    {
    }

    def Mesh "floor" (
        prepend references = @../frontier.usdc@</SUPER/floor>
    )
    {
    }

    def Cube "TopLandingPad" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
        customData = {
            string purpose = "Thin flat landing pad supported by the measured top-floor surface"
        }
    )
    {
        color3f[] primvars:displayColor = [(0.08, 0.22, 0.16)]
        double size = 1
        float3 xformOp:scale = (1, 1, 0.02)
        double3 xformOp:translate = (-0.9829016188466135, 3.6178502063773648, 22.84870930996157)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
